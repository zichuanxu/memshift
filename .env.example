# Copy to .env and export it (set -a; . ./.env; set +a); the code reads os.environ.
# JSON map model id -> OpenAI-compatible base URL; "url1|url2" round-robins.
MEMSHIFT_ENDPOINTS='{"Qwen/Qwen3.5-9B": "http://127.0.0.1:8001/v1", "Qwen/Qwen3-Embedding-0.6B": "http://127.0.0.1:8011/v1"}'
# Optional: long-context server for native systems (Mem0, Graphiti), > 16k tokens.
# MEMSHIFT_ENDPOINTS may also carry "MEMSHIFT_NATIVE_LLM": "http://127.0.0.1:8003/v1".
# OpenAI-compatible (vLLM) servers ignore the key, but the client requires one.
OPENAI_API_KEY=not-needed
# Anthropic API key for claude-* models (ANTHROPIC_API_KEY is read when this one is empty).
CLAUDE_API_KEY=
# Optional: concurrent requests to the Anthropic API (default 8).
MEMSHIFT_CLAUDE_CONCURRENCY=
# Optional: seconds per model request (default 600).
MEMSHIFT_HTTP_TIMEOUT=
# Optional: JSON map model id -> response-cache namespace under cache/llm/.
MEMSHIFT_CACHE_TAGS=
# Optional: a file under runs/; Claude requests that miss the cache are recorded there, not sent.
MEMSHIFT_ANTHROPIC_COLLECT=
# Container image (docker/Dockerfile) for scripts/run.sh and scripts/build_native.sh.
MEMSHIFT_RUN_IMAGE=
