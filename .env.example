# JSON map model id -> OpenAI-compatible base URL; "url1|url2" round-robins.
MEMSHIFT_ENDPOINTS={"Qwen/Qwen3.5-9B": "http://127.0.0.1:8001/v1", "Qwen/Qwen3-Embedding-0.6B": "http://127.0.0.1:8011/v1"}
# Optional: long-context server for native systems (Mem0, Graphiti), > 16k tokens.
# MEMSHIFT_ENDPOINTS may also carry "MEMSHIFT_NATIVE_LLM": "http://127.0.0.1:8003/v1".
OPENAI_API_KEY=not-needed
